---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # The file's own header is placed first automatically (IncludeIsMainRegex).
  - Regex: '^<(gtest|benchmark|yaml-cpp)/'
    Priority: 2
  - Regex: '^<(Eigen|unsupported)/'
    Priority: 2
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  - Regex: '^"navekf/'
    Priority: 4
  - Regex: '.*'
    Priority: 5
